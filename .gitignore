# 密钥与隐私
.credentials.yaml
.anonymous-user-id

# 运行时数据（不入版本管理）
sessions/
storages/
attachments/
llm-deepseek/

# 自动生成的模块 fallback 平面（healProfilesModuleFallback 启动时重建）
profiles/node_modules/

# 各 profile 目录内 pnpm 安装的 node_modules（dsh plugin 管理的构建产物）
profiles/*/node_modules/

# 各 profile 内 healProfileModuleFallback 拥有的 link 平面（同为启动时重建的构建产物）
profiles/*/.dsh-module-fallback/
# Plugin Manager 的 pnpm 运行记录（每次安装/卸载写一条，运行时数据）
profiles/*/.plugin-manager/

# 插件目录内 pnpm 安装的 node_modules（同上，构建产物）
plugins/*/node_modules/
